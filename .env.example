# Database Configuration
DATABASE_URL=sqlite:///./database.db

# Auth (required in production — set a long random string on Railway)
SECRET_KEY=your-secret-key-dev-only

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# OpenAI / LangSmith
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_TRACING=false

# AI safety (Phase C)
MODERATION_ENABLED=true
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_CHAT_RATE_LIMIT=5/minute
AI_PLAN_GEN_RATE_LIMIT=3/hour
AI_SWAP_RATE_LIMIT=10/hour

# TheMealDB API
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# Pexels (recipe hero images for AI-generated recipes)
PEXELS_API_KEY=
PEXELS_API_ENABLED=true
